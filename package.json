{
  "name": "prost",
  "version": "0.0.11",
  "description": "Formula 1 statistics on the command line",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prost": "./index.js",
    "test": "c8 --all --reporter lcovonly --reporter text mocha test/lib/**.test.js",
    "lint": "eslint .",
    "build": "esbuild index.mjs --bundle --platform=node --outfile=dist/prost.cjs --format=cjs --metafile=dist/prost.meta.json",
    "binaries": "pkg dist/prost.cjs --sea"
  },
  "keywords": [
    "formula-1"
  ],
  "author": "James Willock",
  "license": "MIT",
  "preferGlobal": true,
  "bin": {
    "prost": "./index.mjs"
  },
  "dependencies": {
    "@yao-pkg/pkg": "^6.10.1",
    "axios": "^1.15.1",
    "c8": "^10.1.3",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.2",
    "esbuild": "^0.27.0",
    "glob": "^13.0.0",
    "keyv": "^5.5.4",
    "keyv-file": "^5.3.3"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.6.1",
    "axios-mock-adapter": "^2.1.0",
    "chai": "^6.2.1",
    "chai-as-promised": "^8.0.2",
    "eslint": "^9.39.1",
    "mocha": "^11.7.5",
    "mocha-lcov-reporter": "^1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/jameswillock/prost.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
